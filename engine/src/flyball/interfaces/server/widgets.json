{
  "source": "ui/apps/dashboard/src/widgets/*.tsx (WIDGET_KINDS in registry.ts); generated by ui/scripts/widgets-json.ts",
  "bindings": {
    "signal": "a signal address on this rig, e.g. blender.flows.dry",
    "controller": "a controller's name: the address of the signal it drives",
    "device": "a device's name"
  },
  "categories": [
    {
      "id": "readings",
      "label": "Readings"
    },
    {
      "id": "control",
      "label": "Control"
    },
    {
      "id": "status",
      "label": "Status"
    },
    {
      "id": "layout",
      "label": "Layout"
    }
  ],
  "kinds": [
    {
      "kind": "readout",
      "label": "Readout",
      "description": "One signal: its value, unit, position in range and a sparkline.",
      "category": "readings",
      "default_size": {
        "w": 6,
        "h": 5
      },
      "min_size": {
        "w": 4,
        "h": 4
      },
      "cost": "chart",
      "header": true,
      "config": {
        "type": "object",
        "properties": {
          "address": {
            "type": "string",
            "title": "Signal",
            "x-binding": "signal"
          },
          "sparkline": {
            "type": "boolean",
            "title": "Sparkline",
            "default": true,
            "description": "A small trace under the value; off, the tile is a number only."
          },
          "showDevice": {
            "type": "boolean",
            "title": "Show device",
            "default": true
          }
        },
        "required": [
          "address"
        ]
      },
      "ui": {
        "address": {
          "ui:widget": "select"
        },
        "controller": {
          "ui:widget": "select"
        },
        "device": {
          "ui:widget": "select"
        }
      }
    },
    {
      "kind": "gauge",
      "label": "Gauge",
      "description": "One signal as a picture: a dial, bar, thermometer or tank with its warn and alarm zones.",
      "category": "readings",
      "default_size": {
        "w": 6,
        "h": 6
      },
      "min_size": {
        "w": 4,
        "h": 4
      },
      "cost": "cheap",
      "header": true,
      "config": {
        "type": "object",
        "properties": {
          "address": {
            "type": "string",
            "title": "Signal",
            "x-binding": "signal"
          },
          "kind": {
            "type": "string",
            "title": "Kind",
            "default": "auto",
            "oneOf": [
              {
                "const": "auto",
                "title": "by unit"
              },
              {
                "const": "dial",
                "title": "dial"
              },
              {
                "const": "bar",
                "title": "bar"
              },
              {
                "const": "thermometer",
                "title": "thermometer"
              },
              {
                "const": "tank",
                "title": "tank"
              }
            ],
            "description": "By unit: temperatures a thermometer, percentages a tank, else a dial."
          }
        },
        "required": [
          "address"
        ]
      },
      "ui": {
        "address": {
          "ui:widget": "select"
        },
        "controller": {
          "ui:widget": "select"
        },
        "device": {
          "ui:widget": "select"
        },
        "kind": {
          "ui:widget": "select"
        }
      }
    },
    {
      "kind": "chart",
      "label": "Chart",
      "description": "Signals over time on one axis; a signal in another unit gets its own axis on the right.",
      "category": "readings",
      "default_size": {
        "w": 12,
        "h": 8
      },
      "min_size": {
        "w": 8,
        "h": 5
      },
      "cost": "chart",
      "header": true,
      "config": {
        "type": "object",
        "properties": {
          "addresses": {
            "type": "array",
            "title": "Signals",
            "items": {
              "type": "string",
              "title": "",
              "x-binding": "signal"
            },
            "uniqueItems": true,
            "default": []
          },
          "window_s": {
            "type": "number",
            "title": "Window",
            "description": "Seconds of history shown; the trace scrolls once it is full.",
            "default": 0,
            "oneOf": [
              {
                "const": 0,
                "title": "page setting"
              },
              {
                "const": 60,
                "title": "1 min"
              },
              {
                "const": 300,
                "title": "5 min"
              },
              {
                "const": 900,
                "title": "15 min"
              },
              {
                "const": 3600,
                "title": "1 h"
              }
            ]
          },
          "y": {
            "type": "string",
            "title": "Y axis",
            "default": "page",
            "oneOf": [
              {
                "const": "page",
                "title": "page setting"
              },
              {
                "const": "auto",
                "title": "fit the data"
              },
              {
                "const": "range",
                "title": "declared range"
              }
            ]
          }
        },
        "required": [
          "addresses"
        ]
      },
      "ui": {
        "window_s": {
          "ui:widget": "select"
        },
        "y": {
          "ui:widget": "select"
        }
      }
    },
    {
      "kind": "loop",
      "label": "Controller",
      "description": "A controller's faceplate: measured, setpoint and output rows, with the Process/Drive trends beside them.",
      "category": "control",
      "default_size": {
        "w": 8,
        "h": 8
      },
      "min_size": {
        "w": 6,
        "h": 4
      },
      "cost": "chart",
      "header": true,
      "config": {
        "type": "object",
        "properties": {
          "controller": {
            "type": "string",
            "title": "Controller",
            "x-binding": "controller"
          },
          "view": {
            "type": "string",
            "title": "View",
            "default": "full",
            "oneOf": [
              {
                "const": "compact",
                "title": "compact: measured/setpoint/output rows only"
              },
              {
                "const": "full",
                "title": "full: rows and the Process/Drive trends"
              }
            ]
          }
        },
        "required": [
          "controller"
        ]
      },
      "ui": {
        "address": {
          "ui:widget": "select"
        },
        "controller": {
          "ui:widget": "select"
        },
        "device": {
          "ui:widget": "select"
        },
        "view": {
          "ui:widget": "select"
        }
      }
    },
    {
      "kind": "device",
      "label": "Device",
      "description": "A device's state, conditions and run, with a form per command; pick which commands, or show them all.",
      "category": "control",
      "default_size": {
        "w": 6,
        "h": 4
      },
      "min_size": {
        "w": 4,
        "h": 3
      },
      "cost": "cheap",
      "header": true,
      "config": {
        "type": "object",
        "properties": {
          "device": {
            "type": "string",
            "title": "Device",
            "x-binding": "device"
          },
          "commands": {
            "type": "array",
            "title": "Commands",
            "description": "Pick the device first.",
            "items": {
              "type": "string"
            },
            "uniqueItems": true,
            "default": []
          }
        },
        "required": [
          "device"
        ]
      },
      "ui": {
        "address": {
          "ui:widget": "select"
        },
        "controller": {
          "ui:widget": "select"
        },
        "device": {
          "ui:widget": "select"
        }
      }
    },
    {
      "kind": "program",
      "label": "Program",
      "description": "What the programmer is running: the program, its step, progress, and the last few program events.",
      "category": "control",
      "default_size": {
        "w": 8,
        "h": 6
      },
      "min_size": {
        "w": 6,
        "h": 3
      },
      "cost": "cheap",
      "header": true,
      "config": {
        "type": "object",
        "properties": {
          "events": {
            "type": "integer",
            "title": "Recent events",
            "default": 5,
            "minimum": 0,
            "maximum": 50,
            "description": "How many program events to list under the status; 0 for none."
          },
          "cancel": {
            "type": "boolean",
            "title": "Cancel button",
            "default": true
          }
        }
      }
    },
    {
      "kind": "recording",
      "label": "Recording",
      "description": "The open session, and buttons to start or end one.",
      "category": "control",
      "default_size": {
        "w": 6,
        "h": 3
      },
      "min_size": {
        "w": 4,
        "h": 3
      },
      "cost": "cheap",
      "header": true,
      "config": {
        "type": "object",
        "properties": {
          "controls": {
            "type": "boolean",
            "title": "Start/end buttons",
            "default": true,
            "description": "Off, the tile only says whether a session is open."
          }
        }
      }
    },
    {
      "kind": "events",
      "label": "Events",
      "description": "The rig's latest events, newest first, from a level up; optionally one scope only.",
      "category": "status",
      "default_size": {
        "w": 12,
        "h": 6
      },
      "min_size": {
        "w": 6,
        "h": 3
      },
      "cost": "cheap",
      "header": true,
      "config": {
        "type": "object",
        "properties": {
          "level": {
            "type": "string",
            "title": "From level",
            "default": "INFO",
            "enum": [
              "DEBUG",
              "INFO",
              "WARNING",
              "ERROR"
            ],
            "description": "This level and above."
          },
          "limit": {
            "type": "integer",
            "title": "Rows",
            "default": 20,
            "minimum": 1,
            "maximum": 200,
            "description": "At most; the widget shows as many as its height holds."
          },
          "scope": {
            "type": "string",
            "title": "Scope",
            "default": "",
            "description": "Only this scope (`program`, `controller`, `device`, …); blank for all."
          }
        }
      }
    },
    {
      "kind": "health",
      "label": "Health",
      "description": "The rig's condition at a glance: fault or ok, recording, devices polling, controllers, conditions, activities, uptime.",
      "category": "status",
      "default_size": {
        "w": 24,
        "h": 2
      },
      "min_size": {
        "w": 6,
        "h": 2
      },
      "cost": "cheap",
      "header": true,
      "config": {
        "type": "object",
        "properties": {
          "tiles": {
            "type": "array",
            "title": "Tiles",
            "items": {
              "type": "string",
              "oneOf": [
                {
                  "const": "rig",
                  "title": "rig"
                },
                {
                  "const": "recording",
                  "title": "recording"
                },
                {
                  "const": "devices",
                  "title": "devices"
                },
                {
                  "const": "controllers",
                  "title": "controllers"
                },
                {
                  "const": "conditions",
                  "title": "conditions"
                },
                {
                  "const": "activities",
                  "title": "activities"
                },
                {
                  "const": "events",
                  "title": "events"
                },
                {
                  "const": "uptime",
                  "title": "uptime"
                }
              ]
            },
            "uniqueItems": true,
            "default": [
              "rig",
              "recording",
              "devices",
              "controllers",
              "conditions"
            ],
            "description": "Which stats, in this order; none ticked shows the first five."
          }
        }
      }
    },
    {
      "kind": "text",
      "label": "Text",
      "description": "A note: markdown (headings, lists, bold, links) or plain text.",
      "category": "layout",
      "default_size": {
        "w": 6,
        "h": 4
      },
      "min_size": {
        "w": 3,
        "h": 2
      },
      "cost": "cheap",
      "header": true,
      "config": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "title": "Text",
            "default": ""
          },
          "markdown": {
            "type": "boolean",
            "title": "Markdown",
            "default": true
          }
        }
      },
      "ui": {
        "text": {
          "ui:widget": "textarea",
          "ui:options": {
            "rows": 8
          }
        }
      }
    },
    {
      "kind": "heading",
      "label": "Heading",
      "description": "A section title across the grid, to group the tiles under it.",
      "category": "layout",
      "default_size": {
        "w": 24,
        "h": 1
      },
      "min_size": {
        "w": 2,
        "h": 1
      },
      "cost": "cheap",
      "header": false,
      "config": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "title": "Text",
            "default": "Section"
          },
          "size": {
            "type": "string",
            "title": "Size",
            "default": "section",
            "oneOf": [
              {
                "const": "section",
                "title": "section"
              },
              {
                "const": "page",
                "title": "page"
              }
            ]
          }
        },
        "required": [
          "text"
        ]
      }
    },
    {
      "kind": "spacer",
      "label": "Spacer",
      "description": "Empty room, to push tiles apart or start a new row.",
      "category": "layout",
      "default_size": {
        "w": 6,
        "h": 1
      },
      "min_size": {
        "w": 1,
        "h": 1
      },
      "cost": "cheap",
      "header": false,
      "config": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "kind": "link",
      "label": "Link",
      "description": "A button to a page of the app -- a device, a signal, a controller, a program -- or to a URL.",
      "category": "layout",
      "default_size": {
        "w": 4,
        "h": 1
      },
      "min_size": {
        "w": 2,
        "h": 1
      },
      "cost": "cheap",
      "header": false,
      "config": {
        "type": "object",
        "properties": {
          "page": {
            "type": "string",
            "title": "Page",
            "default": "overview",
            "oneOf": [
              {
                "const": "dashboards",
                "title": "Dashboards"
              },
              {
                "const": "overview",
                "title": "Overview"
              },
              {
                "const": "devices",
                "title": "Devices"
              },
              {
                "const": "graph",
                "title": "Graph"
              },
              {
                "const": "controllers",
                "title": "Controllers"
              },
              {
                "const": "programs",
                "title": "Programs"
              },
              {
                "const": "events",
                "title": "Events"
              },
              {
                "const": "sessions",
                "title": "Sessions"
              },
              {
                "const": "simulation",
                "title": "Simulation"
              },
              {
                "const": "rig",
                "title": "Config"
              },
              {
                "const": "url",
                "title": "a URL"
              }
            ]
          },
          "name": {
            "type": "string",
            "title": "Name",
            "default": "",
            "description": "The thing on that page (a device or program name, a signal's or controller's address, a session id); blank for the list."
          },
          "url": {
            "type": "string",
            "title": "URL",
            "default": "",
            "description": "When the page is \"a URL\".",
            "pattern": "^$|^(https?:|mailto:|#|/)"
          },
          "label": {
            "type": "string",
            "title": "Label",
            "default": "",
            "description": "Blank: the page and name."
          },
          "variant": {
            "type": "string",
            "title": "Look",
            "default": "outlined",
            "enum": [
              "outlined",
              "text"
            ]
          }
        },
        "required": [
          "page"
        ]
      },
      "ui": {
        "page": {
          "ui:widget": "select"
        }
      }
    }
  ]
}
