{
  "python.analysis.typeCheckingMode": "basic", // was "strict" — let mypy be the gate
  "python.analysis.diagnosticMode": "openFilesOnly",
  "python.analysis.extraPaths": ["${workspaceFolder}/controller/src"],
  "python.defaultInterpreterPath": "${workspaceFolder}/controller/.venv/bin/python",
  "python.analysis.inlayHints.functionReturnTypes": true,
  // install ms-python.mypy-type-checker
  "mypy-type-checker.importStrategy": "fromEnvironment",
  "mypy-type-checker.cwd": "${workspaceFolder}/controller",
  "mypy-type-checker.reportingScope": "workspace",

  "ruff.importStrategy": "fromEnvironment",
  "[python]": {
    "editor.rulers": [100],
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.organizeImports.ruff": "explicit",
      "source.fixAll.ruff": "explicit"
    }
  }
}
