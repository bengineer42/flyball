    {
      "id": "w6",
      "type": "loop",
      "x": 8,
      "y": 10,
      "w": 8,
      "h": 8,
      "config": {
        "view": "full",
        "controller": "heaters.heater2"
      }
    },
    {
      "id": "w7",
      "type": "loop",
      "x": 16,
      "y": 10,
      "w": 8,
      "h": 8,
      "config": {
        "view": "full",
        "controller": "heaters.heater3"
      }
    },
    {
      "id": "w8",
      "type": "device",
      "x": 0,
      "y": 18,
      "w": 18,
      "h": 5,
      "config": {
        "commands": [],
