{
  "schema_version": 6,
  "name": "furnace",
  "label": "Furnace",
  "rig": "furnace",
  "description": "Three zones, a sample thermocouple, and the heaters holding them.",
  "grid": {
    "cols": 24,
    "row_height": 24
  },
  "widgets": [
    {
      "id": "w1",
      "type": "health",
