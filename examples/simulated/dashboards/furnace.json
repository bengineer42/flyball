{
  "schema_version": 1,
  "name": "furnace",
  "rig": "furnace",
  "description": "Three zones, a sample thermocouple, and the heaters holding them.",
  "grid": {
    "cols": 24,
    "row_height": 24
  },
  "widgets": [
    {
      "id": "w1",
      "kind": "health",
      "x": 0,
      "y": 0,
      "w": 24,
      "h": 2,
      "config": {
        "tiles": [
          "rig",
          "recording",
          "readers",
          "loops",
          "conditions"
        ]
      }
    },
    {
      "id": "w2",
      "kind": "chart",
      "title": "Zones \u00b0C",
      "x": 0,
      "y": 2,
      "w": 18,
      "h": 8,
      "config": {
        "channels": [
          "zone1.temperature",
          "zone2.temperature",
          "zone3.temperature"
        ],
        "window_s": 300,
        "every": 0,
        "y": "auto"
      }
    },
    {
      "id": "w3",
      "kind": "readout",
      "x": 18,
      "y": 2,
      "w": 6,
      "h": 5,
      "config": {
        "channel": "sample.temperature",
        "sparkline": true,
        "showSource": true
      }
    },
    {
      "id": "w4",
      "kind": "text",
      "x": 18,
      "y": 7,
      "w": 6,
      "h": 3,
      "config": {
        "text": "**Cool-down**: stop the heaters before opening the door.",
        "markdown": true
      }
    },
    {
      "id": "w5",
      "kind": "loop",
      "x": 0,
      "y": 10,
      "w": 8,
      "h": 8,
      "config": {
        "loop": "heater1",
        "view": "full"
      }
    },
    {
      "id": "w6",
      "kind": "loop",
      "x": 8,
      "y": 10,
      "w": 8,
      "h": 8,
      "config": {
        "loop": "heater2",
        "view": "full"
      }
    },
    {
      "id": "w7",
      "kind": "loop",
      "x": 16,
      "y": 10,
      "w": 8,
      "h": 8,
      "config": {
        "loop": "heater3",
        "view": "full"
      }
    },
    {
      "id": "w8",
      "kind": "actuator",
      "x": 0,
      "y": 18,
      "w": 6,
      "h": 5,
      "config": {
        "actuator": "heater1",
        "commands": []
      }
    },
    {
      "id": "w9",
      "kind": "actuator",
      "x": 6,
      "y": 18,
      "w": 6,
      "h": 5,
      "config": {
        "actuator": "heater2",
        "commands": []
      }
    },
    {
      "id": "w10",
      "kind": "actuator",
      "x": 12,
      "y": 18,
      "w": 6,
      "h": 5,
      "config": {
        "actuator": "heater3",
        "commands": []
      }
    },
    {
      "id": "w11",
      "kind": "program",
      "x": 0,
      "y": 23,
      "w": 24,
      "h": 6,
