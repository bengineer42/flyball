      "kind": "readout",
      "x": 0,
      "y": 2,
      "w": 6,
      "h": 5,
      "config": {
        "channel": "zone1.temperature",
        "sparkline": true,
        "showSource": true
      }
    },
    {
      "id": "w3",
      "kind": "readout",
      "x": 6,
      "y": 2,
      "w": 6,
      "h": 5,
      "config": {
        "channel": "zone2.temperature",
        "sparkline": true,
        "showSource": true
      }
    },
    {
      "id": "w4",
      "kind": "readout",
      "x": 12,
      "y": 2,
      "w": 6,
      "h": 5,
      "config": {
        "channel": "zone3.temperature",
        "sparkline": true,
        "showSource": true
      }
