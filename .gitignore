# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Python tooling caches
.mypy_cache/
.ruff_cache/
.pytest_cache/
.import_linter_cache/

# Rust (firmware/target is ~1.5 GB)
target/

# KiCad local state
*.kicad_prl
*-backups/
_autosave-*
fp-info-cache

# Editor / tooling
.history/
.playwright-mcp/
.vscode/

# OS
.DS_Store

# git worktrees live here; they are checkouts, not content
.worktrees/

# MkDocs output
build/

# Generated by `flyball rig schema` / `flyball program schema` for editors
examples/**/*.schema.json

*.sqlite
*.sqlite-*
*.sqlite-wal
*.sqlite-shm
*.key

temp/

# local dev/remote-serving setup (tailscale, systemd units) — machine-specific, not code
dev-serve/

# examples/humidity is its own nested git repo now ("humctrl", 22 Sep) — history split out with
# `git subtree split --prefix=examples/humidity`, still lives at this path, not a submodule.
/examples/humidity/

# `go build ./cmd/flyball` from daemon/ (per the book's own install instructions) with no -o
# drops the binary right here.
/daemon/flyball

# a screenshot script writing with an unset base path lands here (e61bc01); guard against it
# recurring rather than committing the file again.
/ui/undefined/