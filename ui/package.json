{
  "name": "flyball-ui",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm --workspace apps/dashboard run dev",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "npm run test --workspaces --if-present",
    "widgets-json": "vite-node --config apps/dashboard/vite.config.ts scripts/widgets-json.ts"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "@vitejs/plugin-react": "^4.3.4"
  }
}
